# Secret used to sign session tokens. REQUIRED in production (min. 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a built-in insecure fallback is used if this is empty.
JWT_SECRET=

# Where the SQLite database file lives (created automatically). Default: data/alumniconnect.db
# DATABASE_PATH=data/alumniconnect.db

# Set to "false" to start with an empty database instead of demo data.
# SEED_DEMO_DATA=true
